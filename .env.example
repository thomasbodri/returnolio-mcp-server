# Copy to .env and fill in. Never commit .env.

# The Ed25519 PUBLIC key the web app's access tokens are verified with: the
# base64 of its SPKI DER, one line (60 characters). The web app holds the
# private key (MCP_JWT_PRIVATE_KEY in its env); this server must never get it,
# and refuses to start if it is handed a private key. Generation: DEPLOY.md,
# "2026-09-28: asymmetric tokens".
MCP_JWT_PUBLIC_KEY=

# Signs the x-mcp-service headers so the gateway can tell a call from this
# server apart from someone replaying a user's bearer token by hand.
# Same value as MCP_SERVICE_SECRET in the frontend's environment.
MCP_SERVICE_SECRET=

# Only during the switch from HS256 (2026-09-28): the end of the window in
# which tokens signed with the old shared MCP_JWT_SECRET are still accepted,
# as an ISO time. Leave both unset otherwise; a window more than 7 days ahead
# is ignored.
# MCP_LEGACY_AUTH_UNTIL=2026-09-30T12:00:00Z
# MCP_JWT_SECRET=
